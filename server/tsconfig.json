{
   "compilerOptions": {
     /* =================================
        PROJECT
     ================================= */
 
     "target": "ES2022",
     "module": "Node16",
     "moduleResolution": "Node16",
 
     /* =================================
        DIRECTORIES
     ================================= */
 
     "rootDir": "./src",
     "outDir": "./dist",
 
     /* =================================
        TYPES
     ================================= */
 
     "types": ["node"],
     "lib": ["ES2022"],
 
     /* =================================
        JAVASCRIPT
     ================================= */
 
     "allowJs": false,
     "checkJs": false,
 
     /* =================================
        MODULE / IMPORTS
     ================================= */
 
     "esModuleInterop": true,
     "allowSyntheticDefaultImports": true,
     "resolveJsonModule": true,
 
     /* =================================
        STRICT TYPE CHECKING
     ================================= */
 
     "strict": true,
     "strictNullChecks": true,
     "strictFunctionTypes": true,
     "strictBindCallApply": true,
     "strictPropertyInitialization": true,
     "noImplicitAny": true,
     "noImplicitThis": true,
     "useUnknownInCatchVariables": true,
 
     /* =================================
        CODE QUALITY
     ================================= */
 
     "noUnusedLocals": true,
     "noUnusedParameters": true,
     "noImplicitReturns": true,
     "noFallthroughCasesInSwitch": true,
 
     /* =================================
        SOURCE MAP
     ================================= */
 
     "sourceMap": true,
     "declaration": false,
 
     /* =================================
        OUTPUT
     ================================= */
 
     "removeComments": true,
     "forceConsistentCasingInFileNames": true,
 
     /* =================================
        THIRD-PARTY TYPES
     ================================= */
 
     "skipLibCheck": true
   },
 
   "include": [
     "src/**/*.ts",
     "express.d.ts"
   ],
 
   "exclude": [
     "node_modules",
     "dist",
     "coverage",
     "tests"
   ]
 }